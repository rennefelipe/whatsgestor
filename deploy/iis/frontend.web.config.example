<?xml version="1.0" encoding="utf-8"?>
<!-- Dedicated frontend site; not the source or private-storage directory. -->
<configuration>
  <system.webServer>
    <rewrite><rules>
      <rule name="WhatsGestor frontend loopback" stopProcessing="true">
        <match url="(.*)" />
        <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" appendQueryString="true" />
      </rule>
    </rules></rewrite>
  </system.webServer>
</configuration>
