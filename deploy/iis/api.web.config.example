<?xml version="1.0" encoding="utf-8"?>
<!-- Dedicated API site. Requires ARR proxy enabled separately by administrator. -->
<configuration>
  <system.webServer>
    <rewrite><rules>
      <rule name="WhatsGestor API loopback" stopProcessing="true">
        <match url="(.*)" />
        <action type="Rewrite" url="http://127.0.0.1:3001/{R:1}" appendQueryString="true" />
      </rule>
    </rules></rewrite>
  </system.webServer>
</configuration>
