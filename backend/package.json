{
  "name": "whatsgestor-backend",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:dev": "node --watch -r ts-node/register src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1 test/automatic-restore.test.cjs test/environment.test.cjs test/application.test.cjs test/auth-users.test.cjs test/users-schema.test.cjs test/registrations.test.cjs test/campaign-preferences.test.cjs test/conversations.test.cjs test/messages.test.cjs test/whatsapp-integration.test.cjs test/whatsapp-rc14.test.cjs test/baileys-rc14-contract.test.cjs test/pairing-reconnect.test.cjs test/auth-storage.test.cjs test/receive-end-to-end.test.cjs test/send-diagnostics.test.cjs test/release-install.test.cjs test/release-audio.test.cjs test/recipient-selections.test.cjs test/modernization.test.cjs test/registration-exchange.test.cjs",
    "pretest:sql": "npm run build",
    "test:sql": "node --test --test-concurrency=1 scripts/sql-connectivity.test.cjs scripts/registrations-connectivity.test.cjs scripts/conversations-connectivity.test.cjs scripts/messages-connectivity.test.cjs scripts/integration-connectivity.test.cjs",
    "db:plan": "node scripts/database.cjs plan",
    "db:migrate": "node scripts/database.cjs migrate",
    "db:bootstrap": "node scripts/database.cjs bootstrap",
    "db:audit": "node scripts/schema-audit.cjs",
    "test:recipients": "node --test test/recipient-selections.test.cjs",
    "test:restore": "npm run build && node --test --test-concurrency=1 test/automatic-restore.test.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/typeorm": "^11.0.3",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "^16.6.1",
    "libphonenumber-js": "1.13.14",
    "mssql": "^12.7.10",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
