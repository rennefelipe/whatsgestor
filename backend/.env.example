# Copy to a private file and replace placeholders. Never commit the real file.
HOST=127.0.0.1
PORT=3001
DB_HOST=sql.example.invalid
DB_PORT=1433
DB_USERNAME=whatsgestor_app
DB_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_PASSWORD
DB_DATABASE=WhatsGestor
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=3600
CORS_ORIGINS=https://app.example.invalid
# Explicit operator authorization is required before enabling these flags.
WHATSAPP_INTEGRATION_ENABLED=false
WHATSAPP_INTEGRATION_AUTO_RESTORE=true
WHATSAPP_INTEGRATION_ALLOW_PAIRING=false
WHATSAPP_INTEGRATION_ALLOW_SEND=false
# Absolute directories outside the installation and web root. Private ACLs required.
WHATSAPP_INTEGRATION_STATE_DIR=C:\ProgramData\WhatsGestor\integration-state
WHATSAPP_SESSIONS_DIR=C:\ProgramData\WhatsGestor\legacy-sessions
WHATSAPP_MEDIA_DIR=C:\ProgramData\WhatsGestor\media
WHATSAPP_RECONNECT_LIMIT=3
WHATSAPP_RECONNECT_BASE_MS=2000
WHATSAPP_RECONNECT_MAX_MS=30000
WHATSAPP_PENDING_LIMIT=256
WHATSAPP_MEDIA_TIMEOUT_MS=30000
WHATSAPP_SEND_TIMEOUT_MS=30000
WHATSAPP_RECOVERY_LIMIT=3
WHATSAPP_RECOVERY_BASE_MS=1000
WHATSAPP_RECOVERY_MAX_MS=30000
MESSAGES_TEXT_MAX_LENGTH=4096
MESSAGES_IMAGE_MAX_BYTES=5242880
MESSAGES_AUDIO_MAX_BYTES=16777216
MESSAGES_VIDEO_MAX_BYTES=20971520
MESSAGES_DOCUMENT_MAX_BYTES=20971520
MESSAGES_FILE_CONCURRENCY=2
MESSAGES_UPLOAD_TIMEOUT_MS=30000
# Opcional: diretório exclusivo para modelos de mensagens (fora do SQL e das sessões WhatsApp).
# APP_SETTINGS_DIRECTORY=C:/ProgramData/WhatsGestor/application-settings
